# MKT-K-CVA source-first policy. Adapted from CCR-K-SFTs; see NOTICE.md.
# Ignores prevent accidental additions, not exposure of already tracked secrets.
~$*
.~lock.*#
*.tmp
*.temp
*.bak
*.backup
*.xlk
*.swp
*.swo
*~
*.orig
*.rej
Thumbs.db
desktop.ini
.DS_Store

# Workbooks are generated; no template path exception is approved.
*.xls
*.xlsx
*.xlsm
*.xlsb
*.xlt
*.xltx
*.xltm
*.xla
*.xlam
*.xll
*.xlw

# Root-scoped build/run output; retained tests/evidence stays trackable.
/build/
/dist/
/out/
/output/
/outputs/
/release-assets/
/test-results/
/test-output/
/coverage/
/htmlcov/
/tmp/
/temp/
/.cache/
.coverage
.coverage.*
coverage.xml

# Local secrets; only deliberately sanitized examples may be committed.
.env
.env.*
!.env.example
*.pfx
*.p12
*.pvk
*.key
*.pem

# Editors and installed tooling; keep source, manifests and lock files.
.vscode/
.idea/
.vs/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.venv/
venv/
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Do not ignore VBA exports (.bas/.cls/.frm/.frx), fixtures, docs or
# tests/evidence. Ordinary .log files are trackable for reviewed evidence;
# disposable logs belong under /test-results/.
